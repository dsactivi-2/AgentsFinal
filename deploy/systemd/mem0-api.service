[Unit]
Description=mem0 Memory API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/social-ai
EnvironmentFile=/root/social-ai/services/mem0-api/.env
ExecStart=/usr/bin/bash /root/social-ai/scripts/start-mem0-api.sh
ExecStop=/usr/bin/bash -c 'kill $(cat /tmp/mem0-api.pid) 2>/dev/null || true'
Restart=always
RestartSec=5
StandardOutput=append:/root/social-ai/logs/mem0-api.log
StandardError=append:/root/social-ai/logs/mem0-api.log

[Install]
WantedBy=multi-user.target
