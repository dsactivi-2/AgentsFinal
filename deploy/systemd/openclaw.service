[Unit]
Description=OpenClaw Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/social-ai
Environment=HOME=/root
ExecStart=/usr/bin/env bash -lc 'openclaw gateway'
Restart=always
RestartSec=10
StandardOutput=append:/root/social-ai/logs/openclaw.log
StandardError=append:/root/social-ai/logs/openclaw.log

[Install]
WantedBy=multi-user.target
