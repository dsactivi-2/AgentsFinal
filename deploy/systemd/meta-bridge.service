[Unit]
Description=Meta Bridge
After=network-online.target openclaw.service
Wants=network-online.target

[Service]
Type=simple
User=agentops
WorkingDirectory=/opt/agentops/services/meta-bridge
EnvironmentFile=/opt/agentops/secrets/meta-bridge.env
ExecStart=/opt/agentops/services/meta-bridge/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8085
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
