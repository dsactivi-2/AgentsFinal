{
  "agents": {
    "defaults": {
      "model": {
        "primary": "ollama/minimax-m2.5:cloud",
        "fallbacks": [
          "ollama/kimi-k2.5:cloud",
          "ollama/leckminartor/qwen3.5-uncensored:397b-cloud"
        ]
      },
      "workspace": "~/.openclaw/workspace-social-ai",
      "timeoutSeconds": 1800,
      "heartbeat": {
        "every": "60m"
      }
    }
  },
  "hooks": {
    "mappings": [
      {
        "match": {
          "path": "meta"
        },
        "action": "agent",
        "agentId": "main",
        "deliver": true
      }
    ]
  },
  "session": {
    "scope": "per-sender",
    "resetTriggers": [
      "/new",
      "/reset"
    ],
    "reset": {
      "mode": "idle",
      "idleMinutes": 1440
    }
  },
  "plugins": {
    "slots": {
      "memory": "memory-core"
    }
  },
  "logging": {
    "level": "info"
  },
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "trustedProxies": ["127.0.0.1"],
    "reload": { "mode": "hybrid" },
    "controlUi": {
      "allowedOrigins": [
        "https://YOUR_DOMAIN",
        "https://YOUR_TAILSCALE_DOMAIN.ts.net"
      ]
    },
    "auth": {
      "mode": "token",
      "token": "REPLACE_WITH_STRONG_TOKEN"
    }
  }
}
