{
  "logging": {
    "level": "info"
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "ollama/minimax-m2.5",
        "fallbacks": [
          "ollama/kimi-k2.5",
          "ollama/qwen3.5:397b"
        ]
      },
      "workspace": "~/.openclaw/workspace-social-ai",
      "compaction": {
        "mode": "safeguard"
      },
      "timeoutSeconds": 1800,
      "heartbeat": {
        "every": "60m"
      }
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "session": {
    "scope": "per-sender",
    "resetTriggers": [
      "/new",
      "/reset"
    ],
    "reset": {
      "mode": "idle",
      "idleMinutes": 1440
    }
  },
  "hooks": {
    "mappings": [
      {
        "match": {
          "path": "meta"
        },
        "action": "agent",
        "agentId": "main",
        "deliver": true
      }
    ]
  },
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "controlUi": {
      "allowedOrigins": [
        "https://marki.ds.activi.io",
        "https://marki.tail47b17c.ts.net"
      ]
    },
    "auth": {
      "mode": "token",
      "token": "REPLACE_WITH_STRONG_TOKEN"
    },
    "trustedProxies": [
      "127.0.0.1"
    ],
    "reload": {
      "mode": "hybrid"
    }
  },
  "plugins": {
    "slots": {
      "memory": "memory-core"
    }
  },
  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "https://ollama.com",
        "models": []
      }
    }
  }
}
