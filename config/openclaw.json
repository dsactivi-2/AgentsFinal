{
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-sonnet-4-6",
        "fallbacks": []
      },
      "workspace": "~/.openclaw/workspace-social-ai",
      "timeoutSeconds": 1800,
      "heartbeat": {
        "every": "60m"
      }
    }
  },
  "hooks": {
    "mappings": [
      {
        "match": {
          "path": "meta"
        },
        "action": "agent",
        "agentId": "main",
        "deliver": true
      }
    ]
  },
  "session": {
    "scope": "per-sender",
    "resetTriggers": [
      "/new",
      "/reset"
    ],
    "reset": {
      "mode": "idle",
      "idleMinutes": 1440
    }
  },
  "plugins": {
    "slots": {
      "memory": "memory-core"
    }
  },
  "logging": {
    "level": "info"
  }
}