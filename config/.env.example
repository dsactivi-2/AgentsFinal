# =============================================================================
# OpenClaw — Provider-Konfiguration
# Kopiere diese Datei nach config/.env und fülle die Werte aus.
# Diese Datei wird von bootstrap.sh automatisch nach ~/.openclaw/.env kopiert.
# =============================================================================

# -----------------------------------------------------------------------------
# Ollama Cloud (Primär-Provider)
# Zugangsdaten unter: https://ollama.com/cloud
# -----------------------------------------------------------------------------
OLLAMA_CLOUD_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_CLOUD_API_BASE=https://api.ollama.com/v1
OLLAMA_CLOUD_MODEL=glm-5:cloud

# -----------------------------------------------------------------------------
# Anthropic (Fallback-Provider)
# Zugangsdaten unter: https://console.anthropic.com
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -----------------------------------------------------------------------------
# Supermemory (mem0 Langzeit-Memory Backend für den Agenten)
# Zugangsdaten unter: https://supermemory.ai — Dashboard → API Keys
# Nutze SUPERMEMORY_CC_API_KEY (Claude Code Plugin Key) falls vorhanden
# -----------------------------------------------------------------------------
SUPERMEMORY_API_KEY=sm_your_supermemory_key_here
SUPERMEMORY_CONTAINER_TAG=social-ai-stack
