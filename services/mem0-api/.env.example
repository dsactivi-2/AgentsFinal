# =============================================================================
# mem0-api Konfiguration
# Variante wird beim bootstrap.sh gewählt:
#   Variant B (Standard): Supermemory Cloud — nur SUPERMEMORY_API_KEY nötig
#   Variant A (Self-hosted): Qdrant + Neo4j + Ollama — Vars unten ausfüllen
# =============================================================================

# -----------------------------------------------------------------------------
# VARIANT B — Supermemory Cloud (Standard)
# API Key unter: https://supermemory.ai → Dashboard → API Keys
# -----------------------------------------------------------------------------
SUPERMEMORY_API_KEY=sm_xxxxxxxxxxxxx

# Container-Tag für Isolation (trennt diesen Stack von anderen Projekten)
SUPERMEMORY_CONTAINER_TAG=social-ai-stack

# Timeout in Sekunden
MEM0_TIMEOUT=15

# -----------------------------------------------------------------------------
# VARIANT A — Self-Hosted (Qdrant + Neo4j + Ollama)
# Nur ausfüllen wenn Variant A beim bootstrap gewählt wurde.
# Docker: docker compose -f deploy/docker-compose.memory.yml up -d
# -----------------------------------------------------------------------------
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# NEO4J_URL=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=changeme

# OLLAMA_BASE=http://localhost:11434
# MEM0_LLM_MODEL=llama3.2
# MEM0_EMBED_MODEL=bge-m3
