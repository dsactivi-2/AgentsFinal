# Meta App Credentials
# Zu finden unter: developers.facebook.com → App → Settings → Basic
META_APP_SECRET=your_app_secret_here

# Selbst gewähltes Token für Webhook-Verifikation (beliebiger String)
META_VERIFY_TOKEN=your_chosen_verify_token

# Page Access Token (dauerhaft)
# developers.facebook.com → App → Messenger → Settings → Access Tokens
META_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Interne OpenClaw Hook-URL (nicht öffentlich)
OPENCLAW_HOOK_URL=http://127.0.0.1:18789/hooks/meta

# Admin PSID (Facebook-PSID des Eigentümers — für Freigabe-Anfragen)
# Zu finden: Schreibe eine Nachricht an deine Page → Meta Bridge Log → psid des Absenders
ADMIN_PSID=your_facebook_psid_here

# Meta Marketing API (für Ads Manager Skill)
# Ad Account ID: developers.facebook.com → Ad Accounts → act_XXXXXXXXX
AD_ACCOUNT_ID=act_your_ad_account_id

# Timeouts (Sekunden)
OPENCLAW_TIMEOUT=45
META_API_TIMEOUT=10

# -----------------------------------------------------------------------------
# Redis (Session-State, persistente Deduplizierung)
# Standard: lokal ohne Auth. Mit Auth: redis://:password@host:6379/0
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# PostgreSQL (Nachrichten-Logging, Audit, Consent)
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=social_ai
DB_USER=postgres
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Vision-Modell (Bildverarbeitung Facebook/Instagram → Textbeschreibung)
# Primär: qwen3.5:cloud via Ollama Cloud (MMMU 85.0, getestet)
# Key + Base aus config/.env werden automatisch geladen
# -----------------------------------------------------------------------------
VISION_MODEL=qwen3.5:cloud
